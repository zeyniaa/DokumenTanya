# Local document chatbot. Install Ollama and pull qwen3:4b first.
# Install parser/OCR dependencies: uv sync --extra ai --extra ocr
PARSER_BACKEND=docling
OCR_ENABLED=true
OCR_ENGINE=rapidocr
EMBEDDING_BACKEND=none
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT=240
JOB_BACKEND=local
DATA_DIR=data
MAX_UPLOAD_MB=20
MAX_PAGES=50
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
